{
  "name": "dsh-cloud-workspaces",
  "version": "0.10.3",
  "description": "Cloud workspaces for DeepSeek Harness: pick \"Cloud (SSH)\" in the workspace chooser and the agent's bash/read/write/edit/glob/grep tools transparently run on your Linux server over SSH. Includes ssh_* agent tools, an SSH host settings card, jump-host support and persistent connection pooling.",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./remote-tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/tools.js"
    },
    "./ssh-service": {
      "types": "./lib/types/ssh-service.d.ts",
      "default": "./lib/ssh-service.js"
    },
    "./job-runner": {
      "types": "./lib/types/job-runner.d.ts",
      "default": "./lib/job-runner.js"
    },
    "./fs-ssh": {
      "types": "./lib/types/fs-ssh.d.ts",
      "default": "./lib/fs-ssh.js"
    },
    "./subprocess-ssh": {
      "types": "./lib/types/subprocess-ssh.d.ts",
      "default": "./lib/subprocess-ssh.js"
    },
    "./client": "./client/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ssh2": "^1.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-fs": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-fs-patch": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-jobs": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.5 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.2-rc.5 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-error": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.5",
    "@deepseek-ai/dsh-http-proxy": "0.2.2-rc.5",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "client",
    "agent-presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harryopo/dsh-cloud-workspaces.git"
  },
  "homepage": "https://github.com/harryopo/dsh-cloud-workspaces",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "remote-development",
    "agent-preset"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  }
}
