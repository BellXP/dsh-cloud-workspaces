+    const socket = net.connect(proxy.port, proxy.host)
+    let settled = false
+    const succeed = (value: net.Socket) => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      socket.removeListener('error', fail)
+      resolve(value)
+    }
+    const fail = (error: Error) => {
+      if (settled) return
+      settled = true
+      clearTimeout(timer)
+      socket.destroy()
+      reject(error instanceof Error ? error : new Error(String(error)))
